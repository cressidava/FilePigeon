{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "FilePigeon",
  "mainBinaryName": "filepigeon-desktop",
  "identifier": "app.filepigeon.desktop",
  "build": {
    "frontendDist": "ui",
    "beforeBuildCommand": "cargo build --release -p filepigeon --bin filepigeon"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "FilePigeon",
        "url": "index.html",
        "width": 1000,
        "height": 680,
        "minWidth": 760,
        "minHeight": 500,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self' ipc: http://ipc.localhost; style-src 'self' 'unsafe-inline'; img-src 'self' data:"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/pigeon-32.png",
      "icons/pigeon-128.png",
      "icons/pigeon-256.png",
      "icons/pigeon.ico"
    ],
    "publisher": "FilePigeon",
    "category": "Utility",
    "shortDescription": "Secure, direct PC-to-PC file transfer",
    "longDescription": "Send files of any size directly between paired PCs, with accept/deny approval, shared folders, and end-to-end encryption.",
    "resources": {
      "../target/release/filepigeon.exe": "filepigeon.exe"
    },
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "installerIcon": "icons/pigeon.ico",
        "displayLanguageSelector": false,
        "installerHooks": "installer-hooks.nsh"
      }
    },
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IENGNTYyRDQ0RjIxQzc0QjgKUldTNGRCenlSQzFXejNpWjE2Szk2dDVPSGdNdTcyWCsxQ3NHS3M4RmlzditEU3dkdG1iaFpidVQK",
      "endpoints": [
        "https://joinfp.panno.tech/update/latest.json"
      ],
      "windows": {
        "installMode": "quiet"
      }
    }
  }
}
